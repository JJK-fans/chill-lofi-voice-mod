<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GamePath Condition=" '$(GamePath)' == '' ">E:\SteamLibrary\steamapps\common\Chill with You Lo-Fi Story\</GamePath>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>JJK.ChillVoiceMod</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <!-- BepInEx -->
        <Reference Include="0Harmony">
            <HintPath>$(GamePath)\BepInEx\core\0Harmony.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="BepInEx">
            <HintPath>$(GamePath)\BepInEx\core\BepInEx.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <!-- Unity -->
        <Reference Include="UnityEngine">
            <HintPath>$(GamePath)\Chill With You_Data\Managed\UnityEngine.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GamePath)\Chill With You_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.AssetBundleModule">
            <HintPath>$(GamePath)\Chill With You_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.AudioModule">
            <HintPath>$(GamePath)\Chill With You_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <!-- Post-build: copy DLL to BepInEx plugins folder -->
    <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(OS)' == 'Windows_NT' And Exists('$(GamePath)\BepInEx\plugins')">
        <Message Importance="High" Text="Installing to: $(GamePath)\BepInEx\plugins\ChillVoiceMod\" />
        <Exec Command="mkdir &quot;$(GamePath)\BepInEx\plugins\ChillVoiceMod&quot; 2&gt;nul &amp; exit 0" />
        <Exec Command="xcopy /Y /I &quot;$(TargetDir)JJK.ChillVoiceMod.dll&quot; &quot;$(GamePath)\BepInEx\plugins\ChillVoiceMod\&quot;" />
    </Target>

</Project>
